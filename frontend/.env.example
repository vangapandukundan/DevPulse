# ─── DevPulse Frontend Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is already in .gitignore.

# API base URL (leave as /api for local dev, set to your backend URL for prod)
# Example: VITE_API_URL=https://api.devpulse.app/api
VITE_API_URL=/api
